#!name=MESL-Surge——v6.2 兴趣裁剪日常去广告
#!desc=V6.2 按你的 App 兴趣目录裁剪：合并 fmz200 blockAds 匹配段 + Walvez StartUpAds 精选 + V6.1 实测遗产（B站/酷安开屏 jq、淘宝/京东/小红书/高德）。支付/银行 MITM 已排除；偶发误伤可关模块后反馈域名。
#!author=你的订阅；上游：fmz200/wool_scripts blockAds（2026-09-10）、Walvez/surge-startup-ads StartUpAds_Selected、V6.1 heritage
#!category=广告拦截
#!system=ios
#!homepage=https://github.com/dalao-all/Surge-Diversion-Rules
#!date=2026-09-20

# V6.2：兴趣裁剪，非全量 730-App。不含 hostname=*；不含 force-http-engine-all。
# 硬排除 MITM：支付宝/云闪付/银行登录域、amdc.m.taobao.com、amdc.alipay.com、ynuf/umdc.aliapp.org、logs.amap.com。
# 不 MITM Apple App Store 核心与微信收款敏感域；B站不解密 gRPC。
# 主配置 Option A owned reject + Alipay/Amap tombstones 不变。


[Rule]

# ---- 广告联盟 (upstream blockAds / 广告联盟) ----
