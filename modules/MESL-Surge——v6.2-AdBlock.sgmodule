# ---- V6.1 heritage: Bilibili splash jq + Coolapk main/init ----
# ---- Bilibili：仅开屏；推荐流实测中位约 786ms，不改写推荐正文（自 V5.2 起） ----
# ---- 酷安：只改 main/init 开屏配置；不再解析 indexV8/replyList/detail/page 等大响应 ----
# 945 是上游脚本标注的开屏实体；sponsorCard 作为结构化广告兜底。保留热门搜索、首页 Tab 与其他配置。
http-response-jq ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(list|show|event\/list2)\? '.data |= with_entries(if .key | IN("show", "event_list") then .value = [] else . end)'
http-response-jq ^https:\/\/api\.coolapk\.com\/v6\/main\/init(?:\?|$) '.data |= (if type == "array" then map(select((.entityId != 945) and (.entityTemplate != "sponsorCard"))) else . end)'

